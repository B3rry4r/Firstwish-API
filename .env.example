# Copy to .env for your own runs (never commit .env). Every variable is described in src/common/env/env.schema.ts.
NODE_ENV=development
PORT=3000
# standin: in-process stand-ins for Paystack, Resend, storage, Anthropic and screening. Refused when NODE_ENV=production.
PROVIDERS=standin
DATABASE_URL=postgresql://firstwish:firstwish@127.0.0.1:5432/fw_dev_test
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-32-or-more-random-characters
REFRESH_TOKEN_PEPPER=replace-with-32-or-more-random-characters
INTERNAL_TOKEN=replace-with-32-or-more-random-characters
AUTH_CODE_PEPPER=replace-with-32-or-more-random-characters
COOKIE_DOMAIN=localhost
WEB_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
# Optional, tests only: a file the stand-in email appends each message to, one JSON line (to, template, subject, text, at). Refused with PROVIDERS=live or NODE_ENV=production.
# STANDIN_MAIL_OUTBOX=/tmp/firstwish-mail.jsonl
# Optional, tests only: whole seconds added to the stand-in clock, read once at boot (restart to change it), so a test stack can reach resting, ended and the end of the restore window. Refused with PROVIDERS=live or NODE_ENV=production.
# STANDIN_CLOCK_OFFSET=86400
# Optional, tests only: rules for the stand-in screening by file name, a comma list of hold:<part of a name> (the file waits in screening) or reject:<part of a name> (the file is refused). Refused with PROVIDERS=live or NODE_ENV=production.
# STANDIN_SCREENING=hold:held,reject:refused
