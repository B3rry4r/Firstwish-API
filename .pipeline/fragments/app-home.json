 },
 "special": {
  "realtime": false,
  "uploads": false,
  "downloads": false,
  "paging": "cursor, infinite scroll, 12 per page",
  "notes": [
   "Refetch of whole feed when account 'shape' (creator|handle|wish ids+isPublic) changes",
   "no polling, no visibility refresh",
   "WishPlayer fetches one wish on open; plays WishData client side",
   "Story slides auto-advance with a client timer (DUR)"
  ]
 },
 "uiStatesHandled": [
  {
   "state": "loading",
   "entersWhen": "!pages[tab].loaded renders skeleton article .ff-wait",
   "reachable": "no today (listFeed is an async function over synchronous local reads: resolves in a microtask); yes once a network call exists"
  },
  {
   "state": "empty (following)",
   "entersWhen": "tab==='following' && page.loaded && no wish items -> FollowEmpty card with creators to follow",
   "reachable": "yes (default, no follows)"
  },
  {
   "state": "empty (for-you / styles)",
   "entersWhen": "none: no empty card; list simply ends with EndCard",
   "reachable": "no"
  },
  {
   "state": "end",
   "entersWhen": "page.loaded && !page.next -> EndCard",
   "reachable": "yes"
  },
  {
   "state": "error",
   "entersWhen": "initial Promise.all or load(more) rejects -> toast only 'The feed did not load. Try again.'",
   "reachable": "no today (local reads never throw); no inline error surface or retry button even when coded"
  },
  {
   "state": "wish overlay error",
   "entersWhen": "getWish rejects -> .ff-player-err with message and Back to the feed",
   "reachable": "yes (a wish id no longer in publicWishes e.g. unpublished)"
  },
  {
   "state": "action failure",
   "entersWhen": "react/save/follow/share rejects -> rollback + toast 'That did not go through. Try again.'",
   "reachable": "no today (localStorage write caught silently)"
  },
  {
   "state": "loaded",
   "entersWhen": "page.loaded with items",
   "reachable": "yes"
  },
  {
   "state": "account wait",
   "entersWhen": "account undefined/null in page.tsx and AppShell -> blank / fa-wait",
   "reachable": "yes (first paint before localStorage read)"
  }
 ],
 "uiStatesDesigned": [
  "loading",
  "empty",
  "error",
  "loaded"
 ],
