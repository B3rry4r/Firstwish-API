  }
 ],
 "actions": [
  {
   "name": "deleteWish",
   "kind": "update",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "status",
     "type": "'removed'",
     "nullable": false
    },
    {
     "name": "removedAt",
     "type": "ISO now",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "page.tsx:68, put(removed(w)); toast Undo calls put(w) (restores whole previous wish object)."
  },
  {
   "name": "restoreWish",
   "kind": "update",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "status",
     "type": "before(w): 'draft' if no no; 'sealed' if no openedAt; 'resting' if endsAt<=now else 'live'",
     "nullable": false
    },
    {
     "name": "removedAt",
     "type": "cleared",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "Client computes the restored status (wish.ts before()); server should decide."
  },
  {
   "name": "eraseWish",
   "kind": "delete",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "none",
    "cardinality": "single"
   },
   "note": "page.tsx:70 dropWish then router.replace('/app/wishes?show=deleted'). Final, copy says photos and link gone."
  },
  {
   "name": "keepLonger",
   "kind": "custom",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "keepKey",
     "type": "'month'|'half'|'year'",
     "nullable": false
    },
    {
     "name": "days",
     "type": "number 30|182|365",
     "nullable": false
    },
    {
     "name": "price",
     "type": "string ₦1,500|₦4,000|₦6,000",
     "nullable": false
    },
    {
     "name": "paymentWay",
     "type": "'card'|'transfer'|'ussd' (PaySheet, not passed on)",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single",
    "note": "status live, endsAt = max(endsAt, now)+days for live; now+days for resting"
   },
   "note": "Paid. Runs after PaySheet onPaid. Also used to wake a resting wish."
  },
  {
   "name": "wakeFreeWithPass",
   "kind": "custom",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "days",
     "type": "365",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "Pass holder, no payment: kept(w,365)."
  },
  {
   "name": "upgradeToKeepsake",
   "kind": "custom",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "ticket",
     "type": "'keepsake'",
     "nullable": false
    },
    {
     "name": "price",
     "type": "₦3,000 (keepsake minus moment, client computed)",
     "nullable": false
    },
    {
     "name": "extraDays",
     "type": "7 if openedAt (TERM_DAYS.keepsake - TERM_DAYS.moment)",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "Paid. If never opened only ticket changes; if opened, endsAt also extends by 7 days via kept()."
  },
  {
   "name": "buyVideo",
   "kind": "custom",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "amount",
     "type": "string ₦2,100 discounted",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "VideoOrder",
    "cardinality": "single"
   },
   "note": "videoPay: only a toast 'The video will be sent to you.' follows payment; nothing recorded. Needs a server order and a file delivery."
  },
  {
   "name": "requestIncludedVideo",
   "kind": "custom",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "VideoOrder",
    "cardinality": "single"
   },
   "note": "Signature/Premiere: toast only today (page.tsx:93)."
  },
  {
   "name": "publish",
   "kind": "update",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "isPublic",
     "type": "true",
     "nullable": false
    },
    {
     "name": "everyoneAgrees",
     "type": "boolean (checkbox gate, local only, not in payload today)",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "Requires creator profile. Sheet says receiver 'is told, and can say no': no such state in code."
  },
  {
   "name": "unpublish",
   "kind": "update",
   "entity": "Wish",
   "payload": [
    {
     "name": "id",
     "type": "string",
     "nullable": false
    },
    {
     "name": "isPublic",
     "type": "false",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Wish",
    "cardinality": "single"
   },
   "note": "Undo re-publishes."
  },
  {
   "name": "payForItem",
   "kind": "custom",
   "entity": "Payment",
   "payload": [
    {
     "name": "title",
     "type": "string",
     "nullable": false
    },
    {
     "name": "amount",
     "type": "string naira text",
     "nullable": false
    },
    {
     "name": "way",
     "type": "'card'|'transfer'|'ussd'",
     "nullable": false
    }
   ],
   "expectedResponse": {
    "entity": "Payment",
    "cardinality": "single"
   },
   "note": "PaySheet is shared; simulated (Pay.tsx:258)."
  },
  {
   "name": "shareLink",
   "kind": "custom",
   "entity": "Wish",
   "payload": [],
   "expectedResponse": {
    "entity": "link string",
    "cardinality": "single"
   },
   "note": "Link is built client-side as {origin}/w/mine?id={wish.id}; preview opens same. Server should issue the public slug link."
  }
 ],
 "authContext": {
  "requiresAuth": true,
  "rolesObserved": [
   "person (owner of the wish)"
  ]
 },
 "special": {
  "realtime": false,
  "uploads": false,
  "downloads": true,
  "note": "Downloads: portrait video file 'sent to you' (delivery channel unspecified). Payments via PaySheet (card, transfer, USSD). Clipboard copy and wa.me share are client-only. Time-driven states (sealed->live at opensAt, live->resting at endsAt, erase after HOLD_DAYS, restore window) are today computed from the phone clock in render (ready(), dayGap)."
 },
 "uiStatesHandled": [
  {
   "state": "loading",
   "entersWhen": "account === undefined (useAccount before first effect); page returns null, no skeleton drawn",
   "reachable": "no",
   "note": "localStorage read is synchronous; `known` module cache makes it undefined only on first mount. Renders null, not a skeleton."
  },
  {
   "state": "empty/not-found",
   "entersWhen": "account.wishes.find(id) is undefined -> 'We could not find that wish.'",
   "reachable": "yes"
  },
  {
   "state": "error",
   "entersWhen": "never coded: no request exists",
   "reachable": "no"
  },
  {
   "state": "loaded-draft",
   "entersWhen": "w.status==='draft'",
   "reachable": "yes"
  },
  {
   "state": "loaded-sealed (waiting / ready)",
   "entersWhen": "status==='sealed'; ready(w) = opensAt<=Date.now()",
   "reachable": "yes",
   "note": "'ready' depends on phone clock; server will own opening."
  },
  {
   "state": "loaded-live (Pass / term)",
   "entersWhen": "status==='live'; passLive = account.pass && live",
   "reachable": "yes"
  },
  {
   "state": "loaded-resting",
   "entersWhen": "status==='resting'",
   "reachable": "yes",
   "note": "Nothing in code moves a live wish to resting on its own; only sample data or server time can."
  },
  {
   "state": "loaded-removed",
   "entersWhen": "status==='removed'",
   "reachable": "yes"
  },
  {
   "state": "pay sheet busy 'Confirming'",
   "entersWhen": "busy after Pay click, 700ms timeout",
   "reachable": "yes",
   "note": "fake"
  }
 ],
 "uiStatesDesigned": [
  "loading",
  "empty",
  "error",
  "loaded"
 ],
 "stubsObserved": [
