   "evidence": "done: () => say(\"The video will be sent to you.\")",
   "standsInFor": "video render order and file delivery",
   "consequence": "Paying for or requesting the video records nothing and sends nothing."
  },
  {
   "file": "lib/account.ts:6",
   "evidence": "Nothing here talks to a server yet: ... held in the browser",
   "standsInFor": "all wish storage and lifecycle",
   "consequence": "Wish status changes (live, resting, erase) only occur through user clicks or seeded sample data, not time."
  },
  {
   "file": "components/app/life/sheets.tsx:16,25",
   "evidence": "setLink(`${window.location.origin}/w/mine?id=${wish.id}`)",
   "standsInFor": "server-issued public wish link slug",
   "consequence": "Shared link uses local id and points at a local-only preview; a receiver on another device sees nothing."
  },
  {
   "file": "components/app/life/wish.ts:83-84,226-227",
   "evidence": "const OFF = 0.4; OFF_LINE = '40% off until 31 January'",
   "standsInFor": "promo configuration with an end date",
   "consequence": "Discount copy never expires; video price hardcoded ₦3,500 * 0.6."
  },
  {
   "file": "lib/account.ts:109-113",
   "evidence": "KEEPS prices as strings '₦1,500' etc.",
   "standsInFor": "price configuration table",
   "consequence": "Prices as formatted text; num() strips non-digits to get numbers."
  },
  {
   "file": "components/app/life/sheets.tsx:125",
   "evidence": "is told, and can say no",
   "standsInFor": "receiver consent step for publishing",
   "consequence": "Copy promises a notification and veto that no code implements."
  },
  {
   "file": "lib/account.ts:133-145",
   "evidence": "sampleWishes(from) with ids s-live, s-sealed, s-rest, s-draft",
