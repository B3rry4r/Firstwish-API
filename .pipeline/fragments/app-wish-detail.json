   "filtersOrSort": [
    "name startsWith 'Portrait video'"
   ],
   "pagination": "none",
   "note": "Decides video included / purchasable / not available per ticket."
  },
  {
   "entity": "PriceConfig (inline constants)",
   "fields": [
    {
     "name": "KEEPS",
     "type": "[{key:'month',label:'One more month',days:30,price:'₦1,500'},{key:'half',label:'Six months',days:182,price:'₦4,000'},{key:'year',label:'A year',days:365,price:'₦6,000'}] (lib/account.ts:109)",
     "nullable": false
    },
    {
     "name": "TERM_DAYS",
     "type": "{moment:7,keepsake:14,signature:30,premiere:60} (lib/account.ts:108)",
     "nullable": false
