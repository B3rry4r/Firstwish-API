  "actions": [
    {
      "name": "toggleChapter",
      "kind": "update",
      "entity": "Wish",
      "payload": [
        {
          "name": "type",
          "type": "ChapterType"
        },
        {
          "name": "keep",
          "type": "boolean"
        },
        {
          "name": "effect",
          "type": "for rule 'on' writes content.off (add/remove type); for rule '+' writes content.on (add/remove type); locked ignored"
        }
      ],
      "expectedResponse": {
        "entity": "Wish",
        "cardinality": "single"
      }
    },
    {
      "name": "continueChapters",
      "kind": "update",
      "entity": "Wish",
      "payload": [
        {
          "name": "content.on",
          "type": "ChapterType[] set to [] if unset so the choice is recorded"
        }
      ],
      "expectedResponse": {
        "entity": "Wish",
        "cardinality": "single"
      }
    },
    {
      "name": "saveDraft",
      "kind": "update",
      "entity": "Wish",
      "payload": [
        {
          "name": "wish",
          "type": "full Wish object (spread of previous plus patch)"
        }
      ],
      "expectedResponse": {
        "entity": "Wish",
        "cardinality": "single"
      },
      "note": "saveWish(w) writes the whole Wish into Account.wishes on every change, debounced 300ms for typing, immediate for choices, plus on pagehide/visibilitychange/unmount. Returns false when browser storage is full (then the 'Not saved: no room left' notice shows and the change is rolled back for immediate saves). Also each step change writes Wish.step."
    },
    {
      "name": "saveMakerNote",
      "kind": "update",
      "entity": "MakerNote",
      "payload": [
        {
          "name": "wishId",
          "type": "string"
        },
        {
          "name": "note",
          "type": "MakerNote"
        }
      ],
      "expectedResponse": {
        "entity": "MakerNote",
        "cardinality": "single"
      }
    }
  ],
  "authContext": {
    "requiresAuth": true,
    "rolesObserved": [
      "person"
    ],
    "note": "The maker renders blank (aria-busy) until an Account is read; there is no redirect to sign in coded in these files (app/app/new layout/page are 8 and 10 lines; not read beyond the scan map). Business wishes (account.pro and spaceOf==business, or kind teams/photographers) count on a plan."
  },
  "special": {
    "realtime": false,
    "uploads": false,
    "downloads": false
  },
  "uiStatesHandled": [
    {
      "state": "loading",
      "entersWhen": "account === undefined/null (useAccount) or wish/screen/play not yet set: renders <div class='fm' aria-busy>",
      "reachable": "no",
      "note": "Account read from localStorage synchronously in an effect; blank for one frame. After wiring to a server it becomes a real fetch of the draft."
    },
    {
      "state": "missing",
      "entersWhen": "?id= given and no wish with that id and status != removed in the account (Maker.tsx:89-90)",
      "reachable": "yes",
      "note": "'That wish is not here' with Start a new wish link. Reachable on another device because drafts are device-local; after wiring, also for a wish owned by someone else or deleted."
    },
    {
      "state": "no-room",
      "entersWhen": "saveWish returns false (localStorage quota) -> header says 'Not saved: no room left' (Maker.tsx:439)",
      "reachable": "yes",
      "note": "Disappears once the server is the store; replaced by a save failure."
    },
    {
      "state": "loaded",
      "entersWhen": "always; list of chapters with switches"
    },
    {
      "state": "no-addable",
      "entersWhen": "offered.length === 0 hides 'Add a chapter' section",
      "reachable": "yes"
    }
  ],
  "uiStatesDesigned": [
    "loading",
    "empty",
    "error",
    "loaded"
  ],
  "stubsObserved": [
    {
      "where": "lib/maker.ts:40-46 saveWish and Maker.tsx:79-118",
      "evidence": "saveWish writes the draft into localStorage 'fw-account'; the maker reads the draft from useAccount() (localStorage)",
      "standsInFor": "a server-held draft Wish saved on every step",
      "consequence": "drafts exist only on one device; ?id= from another device shows 'not here'"
    },
    {
      "where": "lib/maker.ts:28-32 MakerNote in localStorage 'fw-maker'",
      "evidence": "const KEY = \"fw-maker\"; readNote/writeNote",
      "standsInFor": "server-held draft state (given/chosen flags, wedding day, opens-now, voice seconds)",
      "consequence": "these fields have no place on the Wish; a server must store them or the Wish model must grow"
    },
    {
      "where": "lib/account.ts:140 and lib/maker.ts uid()",
      "evidence": "id: uid() = Math.random().toString(36).slice(2,8) client-side; wishNo random four digits (maker.ts:449)",
      "standsInFor": "server-issued id (UUIDv7) and wish number issued in order",
      "consequence": "conventions say server issues both"
    }
  ],
  "note": "Which chapters are kept is derived from recipe plus content.off/on; server must apply the same recipe or accept the lists as sent."
}