      "state": "vault-figure-wait",
      "entersWhen": "storage === null (useVault not loaded) shows an aria-busy placeholder",
      "reachable": "no",
      "note": "getStorage is a synchronous localStorage read wrapped in async; resolves in a microtask. Vault load errors set useVault.error which this page never reads."
    },
    {
      "state": "needs-empty",
      "entersWhen": "needs.length === 0 -> 'All clear'",
      "reachable": "yes"
    },
    {
      "state": "recent-empty",
      "entersWhen": "data.wishes.length === 0 -> Empty 'No client wishes yet.'",
      "reachable": "yes"
    },
    {
      "state": "cannot-make",
      "entersWhen": "!u.canMake -> 'Get wishes' button instead of 'New client wish'",
      "reachable": "yes"
    },
    {
      "state": "pack-variant",
      "entersWhen": "plan === 'pack'",
      "reachable": "yes"
    },
    {
      "state": "error",
      "entersWhen": "never rendered on read: usePro has no error branch; failed writes only toast proProblem(e) (codes offline|full|no_wishes|not_found|failed)",
      "reachable": "no",
      "note": "No read error state and no retry exist."
    }
  ],
