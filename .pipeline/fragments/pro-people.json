  },
  "uiStatesHandled": [
    {
      "state": "loading",
      "entersWhen": "usePro(): data === null on first render before the mount effect runs; page returns null (no skeleton)",
      "reachable": "no",
      "note": "loadPro() is a synchronous localStorage read in useEffect; null for one commit only. Against a server this becomes reachable and needs the app's skeleton."
    },
    {
      "state": "empty",
      "entersWhen": "people.length === 0 -> Empty 'Nobody yet.'",
      "reachable": "yes"
    },
    {
      "state": "no-dates-soon",
      "entersWhen": "no coming date within 30 days -> 'No dates soon'",
      "reachable": "yes"
    },
    {
      "state": "approve-available",
      "entersWhen": "c.days <= 1 and not in approved -> Approve button",
      "reachable": "yes"
    },
    {
      "state": "import-preview",
      "entersWhen": "pasted text non-empty -> 'N ready · M skipped'",
      "reachable": "yes"
    },
    {
      "state": "write-failure-toast",
      "entersWhen": "any action throws -> toast",
      "reachable": "yes"
    },
    {
      "state": "error",
      "entersWhen": "never rendered on read: usePro has no error branch; failed writes only toast proProblem(e) (codes offline|full|no_wishes|not_found|failed)",
      "reachable": "no",
      "note": "No read error state and no retry exist."
    }
  ],
  "uiStatesDesigned": [
    "loading",
    "empty",
    "error",
    "loaded"
  ],
