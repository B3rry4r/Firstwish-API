  "stubsObserved": [
    {
      "file": "lib/vault-api.ts:131-152",
      "evidence": "sendReveal runs addWish() on loadPro() in the browser: client-side wish number (nextNo: max(no,900)+1 padded 4), 'from' month/pack decision, usage count, pack decrement",
      "standsInFor": "server wish creation, numbering, allowance accounting and link slug",
      "consequence": "Wish number, allowance and which pool it counts against are decided by the phone; reveal link is not a server slug"
    },
    {
      "file": "lib/vault-fixtures.ts:11-70",
      "evidence": "samplesOn() true when fw-account.wishes has an id starting 's-'; sampleShoots() builds six hardcoded shoots (ids sample-*, clients Adaeze and Tobi, The Okafor family, Ruth and Daniel, Zainab Musa, Kemi Adebayo, Chioma Eze) with /img/aisha-N.webp urls",
      "standsInFor": "server data",
      "consequence": "Sample rows are merged into every read path while on; a human cannot tell them from real rows"
    },
    {
      "file": "components/app/pro/vault.tsx:18-21",
      "evidence": "revealLink = origin + /w/mine?name=&occasion=&no=<no>&kind=photographers",
      "standsInFor": "a server-issued public link for the reveal",
      "consequence": "Link is built on the client from the wish number and client name; no sealed/open link semantics, anyone with the number can open"
    },
    {
      "file": "lib/vault-api.ts:308",
      "evidence": "online = navigator.onLine === false -> VaultError('offline')",
      "standsInFor": "real request failure",
      "consequence": "'offline' is the only network error; with no network calls, failures never occur otherwise (full is a localStorage quota error)"
    },
    {
      "file": "app/app/pro/reveal/new/page.tsx:97,153",
      "evidence": "'Use sample photos' fills SAMPLE_FRAMES (/img/aisha-1..8.webp, DSC_4801.. names) when samplesOn()",
      "standsInFor": "real photos",
      "consequence": "Demo-only path creates reveals from bundled images"
    },
    {
      "file": "app/app/pro/reveal/new/page.tsx:81-92",
      "evidence": "choose(): files shrunk to a 520px jpeg data URL stored inside the wish in localStorage; the original is discarded",
      "standsInFor": "upload of the frames to storage",
      "consequence": "Loose-frame reveals keep only a thumbnail; full-resolution images never leave the browser"
    },
    {
      "file": "app/app/pro/reveal/new/page.tsx:11",
      "evidence": "const MIN = 6, MAX = 15 frames; ROLES list hardcoded",
      "standsInFor": "a product rule that should be server-validated",
      "consequence": "Limits only enforced by the client"
    }
