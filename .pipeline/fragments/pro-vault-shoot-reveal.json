  "actions": [
    {
      "name": "createClientWish (reveal from loose frames)",
      "kind": "create",
      "entity": "ClientWish",
      "payload": [
        {
          "name": "client",
          "type": "string max 60",
          "nullable": false
        },
        {
          "name": "kind",
          "type": "'photographers'",
          "nullable": false
        },
        {
          "name": "occasion",
          "type": "string",
          "nullable": false
        },
        {
          "name": "day",
          "type": "date today",
          "nullable": false
        },
        {
          "name": "reveal",
          "type": "{frames:Frame[] (src is a ~520px jpeg data URL, file name), shoot, city, date, note, credits, fullSet, booking, style, hearts:[]}",
          "nullable": false
        }
      ],
      "expectedResponse": {
        "entity": "ClientWish",
        "cardinality": "single"
      },
      "note": "frames 6 to 15 required; counted against the month first then the pack; error no_wishes when none left"
    },
    {
      "name": "sendReveal (from a Vault shoot)",
      "kind": "custom",
      "entity": "ClientWish",
      "payload": [
        {
          "name": "shoot",
          "type": "string id",
          "nullable": false
        },
        {
          "name": "set",
          "type": "'proofs'|'finals'",
          "nullable": false
        },
        {
          "name": "reveal",
          "type": "{client,occasion,city,date,note,credits (blank names dropped),booking,style}",
          "nullable": false
        }
      ],
      "expectedResponse": {
        "entity": "{shoot:Shoot, wish:ClientWish}",
        "cardinality": "single"
      },
      "note": "frames are the set's files themselves (by file id); counted as one wish; error no_wishes"
    }
  ],
