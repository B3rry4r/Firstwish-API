    },
    {
      "state": "not-found",
      "entersWhen": "getShoot rejects: lost -> 'Not in the Vault.'",
      "reachable": "yes"
    },
    {
      "state": "spent",
      "entersWhen": "!usage(data,plan).canMake -> Spent card 'No wishes left'",
      "reachable": "yes"
    },
    {
      "state": "form-from-shoot",
      "entersWhen": "?shoot= or route id, set proofs or finals",
      "reachable": "yes"
    },
    {
      "state": "validation",
