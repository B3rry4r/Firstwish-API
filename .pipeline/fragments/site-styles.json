      "consequence": "levels always come from bundled manifests; admin level moves never reach the page"
    },
    {
      "file": "lib/levels.ts:25-27",
      "evidence": "comment: 'Today there is no server, so levels() answers from the manifests'",
      "standsInFor": "the levels service",
      "consequence": "same"
    },
    {
      "file": "components/site/StyleCatalog.tsx:8-9",
      "evidence": "const PAGE = 8; LEVELS = ['Starter','Standard','Premium']",
      "standsInFor": "pagination and level names",
      "consequence": "client-side paging of a bundled list; with a server the list would page by cursor or be fully loaded"
    },
    {
      "file": "app/styles/page.tsx:21-23",
      "evidence": "Act copy 'On every ticket', 'From Keepsake up', 'From Signature up' with counts from stylesAt",
      "standsInFor": "which ticket each level needs (also in LEVEL_GET in lib/catalog.ts:355)",
