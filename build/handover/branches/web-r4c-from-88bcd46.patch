+/* The action words the render sweep looks for on screen: ONE list, in this one place (P-R4C).
+   Two sources, both read when the sweep starts:
+     1. the hint strings the styles, openings and endings themselves draw: every string literal inside a <Hint>...</Hint> or <Hush>...</Hush> in
+        components/** (the two wrappers of components/engine/controls.tsx that draw nothing under the render flag). The whole phrase is looked for,
+        and its first word is looked for as a word on its own ("Tap the flame" gives "tap"; a new hint "Shake to open" gives "shake" with no edit here);
+     2. SEED: the verbs that name an action on any part of a scene that is not a Hint (a button's name, a caption). A word may be added here; a hint
+        string never needs to be.
+   FIRST_WORD_SKIP is the short list of first words that are not an action ("For you", "Wish made", "Not yet"): nothing else is skipped. */
+import fs from "node:fs";
+import path from "node:path";
+
+export const SEED = ["tap", "swipe", "scroll", "press", "hold", "drag", "click", "blow", "open it", "scratch", "unwrap", "pull", "slide", "watch again", "read again", "play again", "replay", "walk it again", "see it again", "throw", "spin", "roll again", "make one", "turn your phone", "paused", "pause", "microphone", "send your", "cut the", "fasten", "break the", "download", "book again", "skip", "mute", "volume"];
+const FIRST_WORD_SKIP = new Set(["for", "send", "it", "wish", "found", "not", "you", "your", "yours", "the", "a", "an", "one", "no", "all", "this", "that", "is", "and", "to", "of", "in", "on", "with", "from", "now", "hint", "line", "more", "cap", "here", "there", "nothing", "done", "ready", "made", "love", "happy"]);
+
+function* walk(dir) {
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    const f = path.join(dir, e.name);
+    if (e.isDirectory()) yield* walk(f); else if (/\.(tsx|ts)$/.test(e.name)) yield f;
+  }
+}
+
+/* the string literals inside every <Hint ...>...</Hint> and <Hush>...</Hush> of the source */
+export function hintStrings(root) {
+  const out = new Set();
+  const re = /<(Hint|Hush)\b[^>]*?(?:>|\n[^>]*>)([\s\S]*?)<\/\1>/g;
+  for (const f of walk(path.join(root, "components"))) {
+    const src = fs.readFileSync(f, "utf8");
+    if (!/<(Hint|Hush)\b/.test(src)) continue;
+    for (const m of src.matchAll(re)) {
+      const body = m[2].replace(/\bk\([^)]*\)/g, " ");
+      for (const s of body.matchAll(/"((?:[^"\\\n]|\\.)+)"|'((?:[^'\\\n]|\\.)+)'|`([^`$\n]+)`/g)) out.add((s[1] ?? s[2] ?? s[3]).trim());
+      for (const x of [...out]) if (/[`${}=]|:--/.test(x)) out.delete(x);
+      const plain = body.replace(/\{[\s\S]*?\}/g, " ").replace(/<[^>]*>/g, " ").trim();
+      if (plain) out.add(plain);
+    }
+  }
+  return [...out].filter((s) => /[A-Za-z]{3}/.test(s) && !/^[a-z-]+$/.test(s));
+}
+
+const esc = (s) => s.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+/* { words: [...every word and phrase], source: {seed, fromHints, phrases} } */
+export function actionWords(root) {
+  const strings = hintStrings(root);
+  const first = new Set();
+  for (const s of strings) { const w = (s.toLowerCase().match(/^[a-z]+/) || [""])[0]; if (w.length >= 3 && !FIRST_WORD_SKIP.has(w)) first.add(w); }
+  const words = [...new Set([...SEED, ...first])];
+  /* a whole phrase counts when it opens with an action word ("Tap the flame"); "For you" or "Wish made" are not actions and may be told */
+  const phrases = strings.filter((s) => s.split(/\s+/).length >= 2).map((s) => s.toLowerCase().replace(/\s+/g, " ")).filter((s) => words.some((w) => s.startsWith(w + " ") || s.startsWith(w + ".")));
+  /* a word that follows "your", "their", a, the... is a noun ("Your turn", "the pull"), not an action */
+  const re = `(?<!\\b(?:your|their|my|his|her|our|a|the|each) )\\b(${words.map(esc).join("|")})\\b`;
+  return { re, phrases, counts: { seed: SEED.length, fromHints: [...first].filter((w) => !SEED.includes(w)).length, hints: strings.length, phrases: phrases.length }, fromHints: [...first].sort() };
+}
