[Unit]
Description=Firstwish render worker (takes only video render jobs; health on 127.0.0.1)
After=network-online.target firstwish-api.service
Wants=network-online.target

[Service]
Type=simple
User=firstwish
Group=firstwish
WorkingDirectory=/opt/firstwish/api
# The same env file as the API, plus the render names (RENDER_*, RENDER_WORKER_ID). No secret is written in this unit.
EnvironmentFile=/etc/firstwish/api.env
Environment=NODE_ENV=production
Environment=PROCESS_ROLE=render-worker
ExecStart=/usr/bin/node dist/render-worker.js
Restart=always
RestartSec=10
# A render is about 1.5 GB: a runaway is stopped here before it takes the whole server.
MemoryMax=3G
# Chromium needs a writable temp folder and its own sandbox rules; keep this unit light.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
