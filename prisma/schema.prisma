/// table: written by E-182..E-184 and server:storage
model StoredFile {
  id                         String              @id @db.Uuid
  ownerAccountId             String?             @db.Uuid
  businessId                 String?             @db.Uuid
  purpose                    StoredFilePurpose
  objectKey                  String
  contentType                String
  bytes                      BigInt
  sha256                     String?
  status                     StoredFileStatus
  variants                   Json
  driver                     StoredFileDriver
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  /// II4: set when a creator deleted a Studio file that an approved version still names; the file stays for that version, out of the creator's lists
  keptAt                     DateTime?           @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)
  fileId                     String?             @db.Uuid
  kind                       StoredFileKind?
  styleId                    String?             @db.Uuid
  shownName                  String?
  /// IL1a (round 21): a video clip's length in milliseconds, read from the stored file itself when it is confirmed (never taken from the browser); null for every other file
  lengthMs                   Int?
  /// IM1 (round 23): set when the stored picture has been re-made without metadata (no GPS, no serial): from then on the bytes at the file's own key ARE that clean copy, and only then is an address for it given. Null: not yet (a file stored before round 23).
  cleanAt                    DateTime?           @db.Timestamptz(3)
  business                   Business?           @relation("StoredFile_businessId", fields: [businessId], references: [id])
  style                      StudioStyle?        @relation("StoredFile_styleId", fields: [styleId], references: [id], onDelete: SetNull)
  ownerAccount               Account?            @relation("StoredFile_ownerAccountId", fields: [ownerAccountId], references: [id])
  file                       StoredFile?         @relation("StoredFile_fileId", fields: [fileId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  aiRequestByInputFile       AiRequest[]         @relation("AiRequest_inputFileId")
  aiRequestByVoiceFile       AiRequest[]         @relation("AiRequest_voiceFileId")
  conciergeOrderByNamesFile  ConciergeOrder[]    @relation("ConciergeOrder_namesFileId")
  conciergeOrderByReportFile ConciergeOrder[]    @relation("ConciergeOrder_reportFileId")
  conciergeOrderFileByFile   ConciergeOrderFile?
  qrCardByFile               QrCard[]            @relation("QrCard_fileId")
  renderJobByOutputFile      RenderJob[]         @relation("RenderJob_outputFileId")
  screeningResultByFile      ScreeningResult[]   @relation("ScreeningResult_fileId")
  signedUrlByFile            SignedUrl[]         @relation("SignedUrl_fileId")
  storedFileByFile           StoredFile[]        @relation("StoredFile_fileId")
  wishFileByFile             WishFile[]          @relation("WishFile_fileId")

  @@index([businessId, id])
  @@index([styleId, id])
  @@index([ownerAccountId, id])
  @@index([fileId, id])
  @@index([status, id])
  @@map("stored_file")
}

/// document: the Studio editor's preferences for one account, stored whole as JSON (written by E-186)
model StudioPrefs {
  id        String   @id @db.Uuid
  document  Json
  accountId String?  @db.Uuid
  account   Account? @relation("StudioPrefs_accountId", fields: [accountId], references: [id])

  @@unique([accountId])
  @@index([accountId, id])
  @@map("studio_prefs")
}

/// document: a Studio style (DEC-65: StudioStyle is the document), stored whole as validated JSON with its owner and state as columns
model StudioStyle {
  id                String       @id @db.Uuid
  liveAt            DateTime?    @db.Timestamptz(3)
  status            String?
  submittedAt       DateTime?    @db.Timestamptz(3)
  document          Json
  version           Int          @default(0)
  accountId         String?      @db.Uuid
  account           Account?     @relation("StudioStyle_accountId", fields: [accountId], references: [id])
  storedFileByStyle StoredFile[] @relation("StoredFile_styleId")

  @@index([accountId, id])
  @@map("studio_style")
}

/// table: the server's style record: slug, level, on/off, creator, counts (DEC-69); written by E-194 and events (DEC-124)
model Style {
  id                     String            @id @db.Uuid
  addedAt                DateTime?         @db.Timestamptz(3)
  by                     String?
  creator                Json?
  dimension              String?
  feel                   String?
  get                    String?
  house                  Boolean?
  img                    String?
  kinds                  Json?
  level                  String?
  light                  Boolean?
  line                   String?
  look                   String?
  mood                   Json?
  motion                 String?
  moves                  String?
  name                   String?
  occasions              Json?
  on                     Boolean?
  orientation            String?
  pace                   String?
  packaged               Boolean?
  paid                   Int?
  pos                    String?
  previews               Int?
  rate                   Int?
  record                 Json?
  sample                 Json?
  say                    String?
  slug                   String?
  tier                   String?
  aiRequestByStyle       AiRequest[]       @relation("AiRequest_styleId")
  reportByStyle          Report[]          @relation("Report_styleId")
  styleSubmissionByStyle StyleSubmission[] @relation("StyleSubmission_styleId")

  @@unique([slug])
  @@index([level, id])
  @@map("style")
}

/// config: style levels set by staff (E-197) and server:style-levels
model StyleLevel {
  id        String          @id @db.Uuid
  styleSlug String
  level     StyleLevelLevel
  since     DateTime        @db.Timestamptz(3)
  by        String
  reason    String?
  slug      String?

  @@map("style_level")
}

/// table: written by E-201, E-202 and server:style-review (DEC-65)
model StyleSubmission {
  id                                  String                   @id @db.Uuid
  styleId                             String                   @db.Uuid
  creatorId                           String                   @db.Uuid
  version                             Int
  checks                              Json
  status                              StyleSubmissionStatus
  level                               StyleSubmissionLevel?
  reviewedBy                          String?
  note                                String?
  createdAt                           DateTime                 @default(now()) @db.Timestamptz(3)
  /// the moment staff approved it (II3/II4); null before approval and for rows approved before this was kept (then createdAt stands in)
  approvedAt                          DateTime?                @db.Timestamptz(3)
  decision                            StyleSubmissionDecision?
  creator                             Creator                  @relation("StyleSubmission_creatorId", fields: [creatorId], references: [id])
  style                               Style                    @relation("StyleSubmission_styleId", fields: [styleId], references: [id])
  styleSubmissionSnapshotBySubmission StyleSubmissionSnapshot? @relation("StyleSubmissionSnapshot_submissionId")
  wishByStyleSubmission               Wish[]                   @relation("Wish_styleSubmissionId")

  @@index([creatorId, id])
  @@index([styleId, id])
  @@index([status, id])
  @@map("style_submission")
}

/// table: API-BASE-11A (DEC-278): the Idempotency-Key a contact-page start carried, as a hash, with a hash of what was sent and the thread it made
model SupportContactKey {
  keyHash     String         @id
  fingerprint String
  threadId    String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  thread      SupportThread? @relation("SupportContactKey_threadId", fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("support_contact_key")
}

/// table: written by E-203 and server:support-threads
model SupportMessage {
  id        String             @id @db.Uuid
  threadId  String             @db.Uuid
  from      SupportMessageFrom
  body      String
  fileIds   String[]           @default([])
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  thread    SupportThread      @relation("SupportMessage_threadId", fields: [threadId], references: [id])

  @@index([threadId, id])
  @@map("support_message")
}

/// table: written by E-204, E-208..E-211 and server:support-threads
model SupportThread {
  id                     String                @id @db.Uuid
  accountId              String?               @db.Uuid
  contact                String
  subject                String
  status                 SupportThreadStatus
  assigneeId             String?               @db.Uuid
  priority               SupportThreadPriority
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  body                   String?
  text                   String?
  name                   String?
  account                Account?              @relation("SupportThread_accountId", fields: [accountId], references: [id])
  assignee               StaffAccount?         @relation("SupportThread_assigneeId", fields: [assigneeId], references: [id])
  supportMessageByThread SupportMessage[]      @relation("SupportMessage_threadId")
  contactKeys            SupportContactKey[]   @relation("SupportContactKey_threadId")

  @@index([accountId, id])
  @@index([assigneeId, id])
  @@index([status, id])
  @@map("support_thread")
}

/// config: house Studio templates served by GET /v1/studio/templates; staff keep them
model Template {
  id          String   @id @db.Uuid
  base        String?
  dimension   String?
  handle      String?
  house       Boolean?
  kinds       Json?
  line        String?
  mood        Json?
  name        String?
  orientation String?
  pace        String?
  theme       Json?

  @@map("template")
}

/// table: written by server:storage (a signed upload granted, waiting for its confirm)
model UploadTicket {
  id          String  @id @db.Uuid
  purpose     String?
  bytes       BigInt?
  contentType String?
  subjectId   String?

  @@map("upload_ticket")
}

/// table: a voice note recorded for a wish (dep-graph VoiceNote to Wish), its audio a StoredFile
model VoiceNote {
  id      String  @id @db.Uuid
  audio   Json?
  data    String?
  seconds Int?
  sound   Json?
  voice   String?
  wishId  String? @db.Uuid
  wish    Wish?   @relation("VoiceNote_wishId", fields: [wishId], references: [id])

  @@index([wishId, id])
  @@map("voice_note")
}

/// table: written by E-217 and server:payments; stored once by event id
model WebhookEvent {
  id             String    @id @db.Uuid
  provider       String
  eventId        String
  type           String
  signatureValid Boolean
  payload        Json
  processedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  event          Json?
  outcome        String?

  @@unique([provider, eventId])
  @@index([createdAt, id])
  @@map("webhook_event")
}

/// table: written by E-220, E-222..E-233 and server:wish-lifecycle; content is a document column; content is JSON (DEC-64 typed WishData, DEC-82 Wish.content.details object) typed object in the registry (HM4, DEC-215)
model Wish {
  id                       String              @id @db.Uuid
  accountId                String              @db.Uuid
  businessId               String?             @db.Uuid
  conciergeOrderId         String?             @db.Uuid
  status                   WishStatus
  ticket                   WishTicket?
  kind                     String
  occasion                 String
  styleSlug                String
  /// the approved Studio submission whose version this wish plays (II3); null for a house style
  styleSubmissionId        String?             @db.Uuid
  /// the level the style had when the wish took it (IJ2): a later raise by staff does not change what the wish may keep; null reads as the style's level now
  styleTakenLevel          String?
  opensAt                  DateTime?           @db.Timestamptz(3)
  timeZone                 String
  weddingDate              DateTime?           @db.Date
  sealedAt                 DateTime?           @db.Timestamptz(3)
  openedAt                 DateTime?           @db.Timestamptz(3)
  endsAt                   DateTime?           @db.Timestamptz(3)
  restingSince             DateTime?           @db.Timestamptz(3)
  keptUntil                DateTime?           @db.Timestamptz(3)
  removedAt                DateTime?           @db.Timestamptz(3)
  eraseAfter               DateTime?           @db.Timestamptz(3)
  restorableUntil          DateTime?           @db.Timestamptz(3)
  erasedAt                 DateTime?           @db.Timestamptz(3)
  keptBy                   WishKeptBy?
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)
  adds                     Json?
  content                  Json?
  keep                     WishKeep?
  makerNote                Json?
  name                     String?
  no                       String?
  step                     Int?
  version                  Int                 @default(0)
  passcodeHash             String?
  account                  Account             @relation("Wish_accountId", fields: [accountId], references: [id])
  business                 Business?           @relation("Wish_businessId", fields: [businessId], references: [id])
  aiRequestByWish          AiRequest[]         @relation("AiRequest_wishId")
  clientWishByWish         ClientWish?         @relation("ClientWish_wishId")
  eventByWish              Event[]             @relation("Event_wishId")
  noticeByWish             Notice[]            @relation("Notice_wishId")
  publishRequestByWish     PublishRequest[]    @relation("PublishRequest_wishId")
  qrCardByWish             QrCard[]            @relation("QrCard_wishId")
  renderJobByWish          RenderJob[]         @relation("RenderJob_wishId")
  reportByWish             Report[]            @relation("Report_wishId")
  voiceNoteByWish          VoiceNote[]         @relation("VoiceNote_wishId")
  wishLinkByWish           WishLink[]          @relation("WishLink_wishId")
  wishTransitionByWish     WishTransition[]    @relation("WishTransition_wishId")
  publishedWishByWish      PublishedWish[]     @relation("PublishedWish_wishId")
  royaltyAccrualByWish     RoyaltyAccrual[]    @relation("RoyaltyAccrual_wishId")
  wishOpenByWish           WishOpen[]          @relation("WishOpen_wishId")
  wishFileByWish           WishFile[]          @relation("WishFile_wishId")
  purchaseGrantByWish      PurchaseGrant[]     @relation("PurchaseGrant_wishId")
  wishReactionByWish       WishReaction[]      @relation("WishReaction_wishId")
  wishFavouriteByWish      WishFavourite[]     @relation("WishFavourite_wishId")
  wishGatherByWish         WishGather?         @relation("WishGather_wishId")
  wishGatherVoiceByWish    WishGatherVoice[]   @relation("WishGatherVoice_wishId")
  passDrawByWish           PassDraw[]          @relation("PassDraw_wishId")
  takeDownCodeByWish       TakeDownCode[]      @relation("TakeDownCode_wishId")
  conciergeOrderWishByWish ConciergeOrderWish? @relation("ConciergeOrderWish_wishId")
  conciergeOrder           ConciergeOrder?     @relation("Wish_conciergeOrderId", fields: [conciergeOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  styleSubmission          StyleSubmission?    @relation("Wish_styleSubmissionId", fields: [styleSubmissionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wishStartByWish          WishStart[]         @relation("WishStart_wishId")

  @@unique([no])
  @@index([accountId, id])
  @@index([businessId, id])
  @@index([status, id])
  @@index([conciergeOrderId])
  @@index([styleSubmissionId])
  @@map("wish")
}

/// table: written by server:wish-link (a wish's public slug)
model WishLink {
  id          String    @id @db.Uuid
  slug        String    @db.VarChar(32)
  wishId      String    @db.Uuid
  active      Boolean
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  tries       Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  wish        Wish      @relation("WishLink_wishId", fields: [wishId], references: [id])

  @@unique([slug])
  @@index([wishId, id])
  @@map("wish_link")
}

/// table: written by server:wish-number (issues wish numbers in order)
model WishNumberSequence {
  id        String   @id @db.Uuid
  next      Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("wish_number_sequence")
}

/// table: written by server:wish-link (E-131 records an opening of the public link); LL1: the wish it is for, the kind of row (read or play), whether it was the first opening and the opening session (a hash, never an address)
model WishOpen {
  id        String   @id @db.Uuid
  slug      String?
  wishId    String?  @db.Uuid
  kind      String   @default("read")
  first     Boolean  @default(false)
  session   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  wish      Wish?    @relation("WishOpen_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([wishId, id])
  @@map("wish_open")
}

/// table: written by server:wish-lifecycle (every state change of a wish, with the job run that made it)
model WishTransition {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  from      String
  to        String
  cause     String
  jobRunId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  jobRun    JobRun?  @relation("WishTransition_jobRunId", fields: [jobRunId], references: [id])
  wish      Wish     @relation("WishTransition_wishId", fields: [wishId], references: [id])

  @@index([jobRunId, id])
  @@index([wishId, id])
  @@index([createdAt, id])
  @@map("wish_transition")
}

/// table: Y5: a file a wish names (wish, file, role), written when the content is saved; the foreign key keeps a file in a wish from being deleted by any race
model WishFile {
  id        String       @id @db.Uuid
  wishId    String       @db.Uuid
  fileId    String       @db.Uuid
  role      WishFileRole
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  wish      Wish         @relation("WishFile_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file      StoredFile   @relation("WishFile_fileId", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([wishId, fileId, role])
  @@index([wishId, id])
  @@index([fileId, id])
  @@map("wish_file")
}

/// table: EE1: the time limit of one run of each kind of job, in seconds (60 unless a row says otherwise); a config table, no contract shape
model JobKindConfig {
  id               String @id @db.Uuid
  kind             String
  timeLimitSeconds Int

  @@unique([kind])
  @@map("job_kind_config")
}

/// table: GG1: what each paid line granted, one row per payment and line (a handler claims its row first, a refund reads it to take the grant back); written by SQL inside the payment's own transaction; accountId and businessId are plain ids (no relation to Account or Business, so the table is not an owned table of the erase gate; its text columns hold no person, rules below)
model PurchaseGrant {
  id            String    @id @db.Uuid
  paymentId     String    @db.Uuid
  sku           String
  kind          String
  accountId     String?   @db.Uuid
  businessId    String?   @db.Uuid
  wishId        String?   @db.Uuid
  detail        Json      @default("{}")
  startsAt      DateTime  @db.Timestamptz(3)
  endsAt        DateTime? @db.Timestamptz(3)
  refusedReason String?
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @db.Timestamptz(3)
  payment       Payment   @relation("PurchaseGrant_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wish          Wish?     @relation("PurchaseGrant_wishId", fields: [wishId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([paymentId, sku])
  @@index([paymentId, id])
  @@index([wishId, id])
  @@index([businessId, kind])
  @@index([accountId, kind])
  @@map("purchase_grant")
}

/// table: LL1: one reaction per opening session of a wish, changeable; written by SQL from the receiver's link, counted for the owner
model WishReaction {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  session   String
  reaction  String
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  wish      Wish     @relation("WishReaction_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([wishId, session])
  @@index([wishId, id])
  @@map("wish_reaction")
}

/// table: LL1: the photo positions an opening session marked, one set per session of a wish; written by SQL from the receiver's link
model WishFavourite {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  session   String
  hearts    Int[]
  updatedAt DateTime @db.Timestamptz(3)
  wish      Wish     @relation("WishFavourite_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([wishId, session])
  @@index([wishId, id])
  @@map("wish_favourite")
}

/// table: HS1: the gather link a wish's owner gives friends to add a voice (one per wish; slug is the link's own, never the wish's link); written by server:gather
model WishGather {
  id        String   @id @db.Uuid
  slug      String   @db.VarChar(32)
  wishId    String   @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  wish      Wish     @relation("WishGather_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([slug])
  @@unique([wishId])
  @@map("wish_gather")
}

/// table: HS1: who a friend's voice note is from (the friend's first name), one row per voice added through a gather link
model WishGatherVoice {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  fromName  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  wish      Wish     @relation("WishGatherVoice_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([wishId, id])
  @@map("wish_gather_voice")
}

/// table: LL1, LL4: the public link's limits counted in the database: a bucket, a key (a hash of the address, never the address) and the time; old rows are removed by a timed job
model LinkHit {
  id     String   @id @db.Uuid
  bucket String
  key    String
  at     DateTime @db.Timestamptz(3)

  @@index([bucket, key, at])
  @@map("link_hit")
}

/// table: GG3, GG5: a wish or an upgrade drawn from an account's Pass for one wish; the unique key keeps a wish from drawing twice, and the draw is made in the same transaction as the counter
model PassDraw {
  id           String         @id @db.Uuid
  accountId    String         @db.Uuid
  wishId       String         @db.Uuid
  membershipId String         @db.Uuid
  kind         PassDrawKind
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  account      Account        @relation("PassDraw_accountId", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wish         Wish           @relation("PassDraw_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  membership   PassMembership @relation("PassDraw_membershipId", fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([wishId, kind])
  @@index([accountId, id])
  @@index([wishId, id])
  @@index([membershipId, id])
  @@map("pass_draw")
}

/// table: OO4 (B17): the invoice number counter, one row (id 1), taken with a row lock inside the settle transaction so numbers run in order with no gaps; a config table, no contract shape
model InvoiceCounter {
  id   Int @id
  last Int

  @@map("invoice_counter")
}

/// table: OO4 (B17): what ties an invoice to the payment it came from, its period and whether a refund voided it; one row per invoice
model InvoiceLink {
  invoiceId   String    @id @db.Uuid
  paymentId   String    @db.Uuid
  periodStart DateTime? @db.Timestamptz(3)
  periodEnd   DateTime? @db.Timestamptz(3)
  voidedAt    DateTime? @db.Timestamptz(3)
  invoice     Invoice   @relation("InvoiceLink_invoiceId", fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment     Payment   @relation("InvoiceLink_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId])
  @@map("invoice_link")
}

/// table: QQ6 (B13): the staff reason for one decision (a publish request or a report), read back by the owner (decline) and the staff queues; the subject is one of two tables, so no foreign key
model ModerationDecision {
  subject   String
  subjectId String   @db.Uuid
  reason    String
  decidedAt DateTime @db.Timestamptz(3)

  @@id([subject, subjectId])
  @@map("moderation_decision")
}

/// table: QQ6 (B13): the report limit per address, counted in the database: a key (an HMAC of the address, never the address) and the time
model ReportHit {
  id     String   @id @db.Uuid
  bucket String
  key    String
  at     DateTime @db.Timestamptz(3)

  @@index([bucket, key, at])
  @@map("report_hit")
}

/// table: QQ6 (B13): 'This is me, take it down': the code mailed to the address before a report counts; short lived, removed once used or expired
model TakeDownCode {
  id        String    @id @db.Uuid
  wishId    String    @db.Uuid
  email     String
  codeHash  String
  tries     Int       @default(0)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @db.Timestamptz(3)
  wish      Wish      @relation("TakeDownCode_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([wishId, email])
  @@map("take_down_code")
}

/// table: CA2 (B19): a Concierge order's own price (kobo, fixed when it is placed), its payment and its times
model ConciergeOrderExt {
  orderId     String         @id @db.Uuid
  amountKobo  BigInt
  listKobo    BigInt
  paymentId   String?        @db.Uuid
  paidAt      DateTime?      @db.Timestamptz(3)
  dueAt       DateTime?      @db.Timestamptz(3)
  givenAt     DateTime?      @db.Timestamptz(3)
  deliveredAt DateTime?      @db.Timestamptz(3)
  cancelledAt DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  order       ConciergeOrder @relation("ConciergeOrderExt_orderId", fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payment     Payment?       @relation("ConciergeOrderExt_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId])
  @@index([dueAt])
  @@map("concierge_order_ext")
}

/// table: CA2 (B19): the wishes a maker delivered for an order (a wish is delivered under one order only)
model ConciergeOrderWish {
  orderId     String         @db.Uuid
  wishId      String         @db.Uuid
  deliveredAt DateTime       @default(now()) @db.Timestamptz(3)
  order       ConciergeOrder @relation("ConciergeOrderWish_orderId", fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  wish        Wish           @relation("ConciergeOrderWish_wishId", fields: [wishId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([orderId, wishId])
  @@unique([wishId])
  @@index([wishId])
  @@map("concierge_order_wish")
}

/// table: IC7 (T-12): a file the buyer gave with a Concierge order (a photo or a voice note), tied to the order from the order's placing until it is delivered or cancelled
model ConciergeOrderFile {
  fileId    String         @id @db.Uuid
  orderId   String         @db.Uuid
  kind      String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  file      StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order     ConciergeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId, fileId])
  @@map("concierge_order_file")
}

/// table: YY3 (B20): an address that complained: no more email goes to it; keyed by the address's keyed hash
model EmailSuppression {
  hash      String   @id
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("email_suppression")
}

/// table: YY3 (B20): contact-page and inbound-mail intake: one row per (kind, key, UTC day), raised by one conditional statement so two requests at once cannot both pass the last place
model SupportIntakeCount {
  kind  String
  key   String
  day   DateTime @db.Date
  count Int

  @@id([kind, key, day])
  @@index([day])
  @@map("support_intake_count")
}

/// table: WW4 (B16): what the payout table has no column for: when it was handed to the provider and when it was paid, why it failed, the staff note of a manual paid, and the short lease that keeps two runs from sending one payout at once
model PayoutDetail {
  payoutId      String    @id @db.Uuid
  sentAt        DateTime? @db.Timestamptz(3)
  paidAt        DateTime? @db.Timestamptz(3)
  failedAt      DateTime? @db.Timestamptz(3)
  failureReason String?
  note          String?
  sendingUntil  DateTime? @db.Timestamptz(3)
  payout        Payout    @relation("PayoutDetail_payoutId", fields: [payoutId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("payout_detail")
}

/// table: WW4 (B16): the negative row of a refunded payment's royalty: one row per accrual, never a delete of the accrual
model RoyaltyReversal {
  id         String         @id @db.Uuid
  accrualId  String         @db.Uuid
  creatorId  String         @db.Uuid
  paymentId  String         @db.Uuid
  amountKobo BigInt
  month      String
  createdAt  DateTime       @db.Timestamptz(3)
  accrual    RoyaltyAccrual @relation("RoyaltyReversal_accrualId", fields: [accrualId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator    Creator        @relation("RoyaltyReversal_creatorId", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment    Payment        @relation("RoyaltyReversal_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([accrualId])
  @@index([creatorId, id])
  @@index([paymentId])
  @@map("royalty_reversal")
}

/// table: XX4 (B15): the frozen draft of each submission (T-63: the checks and the reviewer read the snapshot, never the live draft); accountId is a plain id (no relation, so the table is not an owned table of the erase gate)
model StyleSubmissionSnapshot {
  id           String          @id @db.Uuid
  submissionId String          @db.Uuid
  accountId    String          @db.Uuid
  document     Json
  used         String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  submission   StyleSubmission @relation("StyleSubmissionSnapshot_submissionId", fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([submissionId])
  @@index([accountId])
  @@map("style_submission_snapshot")
}

/// table: EA1 (B18): what a reveal link holds beyond reveal_link: its code, passcode, wrong tries, end, switched off, the chosen files; the one-per-client-wish rule is a partial unique index kept in SQL
model RevealAccess {
  linkId       String      @id @db.Uuid
  businessId   String      @db.Uuid
  shootId      String?     @db.Uuid
  wishId       String?     @db.Uuid
  setName      String      @map("set")
  code         String
  fileIds      Json        @default("[]")
  passcodeHash String?
  tries        Int         @default(0)
  lockedUntil  DateTime?   @db.Timestamptz(3)
  endsAt       DateTime?   @db.Timestamptz(3)
  offAt        DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  hearts       String[]    @default([]) @db.Uuid
  downloads    Boolean     @default(true)
  link         RevealLink  @relation("RevealAccess_linkId", fields: [linkId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  business     Business    @relation("RevealAccess_businessId", fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shoot        Shoot?      @relation("RevealAccess_shootId", fields: [shootId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wish         ClientWish? @relation("RevealAccess_wishId", fields: [wishId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([code])
  @@index([businessId])
  @@index([shootId])
  @@map("reveal_access")
}

/// table: EA1 (B18): one row per visit of a reveal link, holding a keyed hash of the visitor and never the visitor (the table is named reveal_play)
model RevealVisit {
  id     String     @id @db.Uuid
  linkId String     @db.Uuid
  visit  String
  at     DateTime   @db.Timestamptz(3)
  link   RevealLink @relation("RevealVisit_linkId", fields: [linkId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([linkId, visit])
  @@map("reveal_play")
}

/// table: EA1 (B18): the sends of a reveal that carried an Idempotency-Key, so a repeat sends nothing twice
model RevealSend {
  id         String   @id @db.Uuid
  businessId String   @db.Uuid
  key        String
  wishId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  business   Business @relation("RevealSend_businessId", fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([businessId, key])
  @@map("reveal_send")
}

/// table: EA1 (B18): the most a business's Vault held in a month, in bytes (the peak the monthly billing reads)
model VaultPeak {
  businessId String   @db.Uuid
  month      String
  bytes      BigInt
  business   Business @relation("VaultPeak_businessId", fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([businessId, month])
  @@map("vault_peak")
}

/// table: HM3 (DEC-214): the Idempotency-Key a person started a wish with and the draft it answered, so the same key answers the same draft whatever happened to the draft since
model WishStart {
  id        String   @id @db.Uuid
  accountId String   @db.Uuid
  key       String
  wishId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  account   Account  @relation("WishStart_accountId", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wish      Wish     @relation("WishStart_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([accountId, key])
  @@index([accountId, id])
  @@index([wishId, id])
  @@map("wish_start")
}

