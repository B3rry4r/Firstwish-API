// Firstwish database schema. Kept by hand together with a new migration for every change (the registry-to-schema generator is retired);
// scripts/check-drift.mjs migrates a fresh database and fails when the migrations and this file part ways.
// Ids are UUIDv7 issued by the server; money is BigInt kobo; times are timestamptz UTC; calendar dates are date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// table: written by E-3, E-7, E-9, E-11 and server:sessions; the person's account (sessions declaration Me); erase really removes personal fields, so name, contact (the email, S-27), phone, bio and handle are nullable in storage
model Account {
  id                        String             @id @db.Uuid
  name                      String?
  contact                   String?
  sides                     AccountSides[]     @default([])
  lastSide                  String
  bio                       String?
  business                  String?
  creator                   Boolean?
  dates                     Json?
  handle                    String?
  mode                      AccountMode        @default(system)
  phone                     String?
  pro                       Json?
  side                      Json?
  space                     AccountSpace?
  timeZone                  String?
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  erasedAt                  DateTime?          @db.Timestamptz(3)
  aiRequestByAccount        AiRequest[]        @relation("AiRequest_accountId")
  banByAccount              Ban[]              @relation("Ban_accountId")
  conciergeOrderByAccount   ConciergeOrder[]   @relation("ConciergeOrder_accountId")
  creatorStateByAccount     CreatorState?      @relation("CreatorState_accountId")
  eventByAccount            Event[]            @relation("Event_accountId")
  externalIdentityByAccount ExternalIdentity[] @relation("ExternalIdentity_accountId")
  noticeByAccount           Notice[]           @relation("Notice_accountId")
  paymentByAccount          Payment[]          @relation("Payment_accountId")
  reportByAccount           Report[]           @relation("Report_accountId")
  sessionByAccount          Session[]          @relation("Session_accountId")
  supportThreadByAccount    SupportThread[]    @relation("SupportThread_accountId")
  wishByAccount             Wish[]             @relation("Wish_accountId")
  businessByAccount         Business[]         @relation("Business_accountId")
  creatorByAccount          Creator?           @relation("Creator_accountId")
  dateRowByAccount          DateRow[]          @relation("DateRow_accountId")
  followByAccount           Follow[]           @relation("Follow_accountId")
  noticePrefsByAccount      NoticePrefs?       @relation("NoticePrefs_accountId")
  passMembershipByAccount   PassMembership[]   @relation("PassMembership_accountId")
  reactionByAccount         Reaction[]         @relation("Reaction_accountId")
  savedWishByAccount        SavedWish[]        @relation("SavedWish_accountId")
  shareByAccount            Share[]            @relation("Share_accountId")
  studioPrefsByAccount      StudioPrefs?       @relation("StudioPrefs_accountId")
  studioStyleByAccount      StudioStyle[]      @relation("StudioStyle_accountId")
  storedFileByOwnerAccount  StoredFile[]       @relation("StoredFile_ownerAccountId")
  passDrawByAccount         PassDraw[]         @relation("PassDraw_accountId")
  wishStartByAccount        WishStart[]        @relation("WishStart_accountId")

  @@unique([contact])
  @@unique([handle])
  @@map("account")
}

/// table: written by E-12..E-16 and server:ai-writing (one row per AI request, credits charged)
model AiRequest {
  id           String          @id @db.Uuid
  accountId    String          @db.Uuid
  kind         AiRequestKind
  inputFileId  String?         @db.Uuid
  transcript   String?
  output       Json?
  creditsSpent Int
  status       AiRequestStatus
  model        String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  ask          String?
  base         String?
  description  String?
  fileIds      Json?
  instruction  String?
  made         Json?
  prompt       String?
  styleId      String?         @db.Uuid
  target       Json?
  voiceFileId  String?         @db.Uuid
  wishId       String?         @db.Uuid
  account      Account         @relation("AiRequest_accountId", fields: [accountId], references: [id])
  style        Style?          @relation("AiRequest_styleId", fields: [styleId], references: [id])
  wish         Wish?           @relation("AiRequest_wishId", fields: [wishId], references: [id])
  inputFile    StoredFile?     @relation("AiRequest_inputFileId", fields: [inputFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voiceFile    StoredFile?     @relation("AiRequest_voiceFileId", fields: [voiceFileId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([accountId, id])
  @@index([styleId, id])
  @@index([wishId, id])
  @@index([inputFileId, id])
  @@index([voiceFileId, id])
  @@index([status, id])
  @@map("ai_request")
}

/// table: the dates a business has approved for its people, read by GET /v1/business/approved-dates and written by POST and DELETE /v1/business/approved-dates (BB1, DEC-168); each row is one business's
model ApprovedDate {
  id         String   @id @db.Uuid
  key        String?
  businessId String   @db.Uuid
  business   Business @relation("ApprovedDate_businessId", fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([businessId, key])
  @@index([businessId, id])
  @@map("approved_date")
}

/// table: written by server:audit-log in the same transaction as every staff change (DEC-117); append-only, no update (database trigger)
model AuditEntry {
  id          String              @id @db.Uuid
  actorType   AuditEntryActorType
  actorId     String?             @db.Uuid
  action      String
  subjectType String
  subjectId   String
  before      Json?
  after       Json?
  ip          String?
  requestId   String
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  section     String              @default("")
  reason      String?

  @@index([actorId, id])
  @@index([section, id])
  @@index([subjectType, id])
  @@index([createdAt, id])
  @@map("audit_entry")
}

/// table: written by E-19, E-20 and server:auth-codes (one-time sign-in codes, hashed)
model AuthCode {
  id          String          @id @db.Uuid
  channel     AuthCodeChannel
  destination String
  codeHash    String
  purpose     AuthCodePurpose
  attempts    Int
  expiresAt   DateTime        @db.Timestamptz(3)
  consumedAt  DateTime?       @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  mode        AuthCodeMode?
  via         AuthCodeVia?
  canonical   String?
  triedFrom   String[]        @default([])

  @@index([canonical, createdAt])
  @@index([ip, createdAt])
  @@map("auth_code")
}

/// table: written by E-21 and server:moderation
model Ban {
  id        String    @id @db.Uuid
  accountId String    @db.Uuid
  scope     BanScope
  reason    String
  until     DateTime? @db.Timestamptz(3)
  by        String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  account   Account   @relation("Ban_accountId", fields: [accountId], references: [id])

  @@index([accountId, id])
  @@map("ban")
}

/// table: written by E-22 (a creator's payout bank account)
model BankAccount {
  id                  String   @id @db.Uuid
  accountNumber       String?
  bankCode            String?
  creatorId           String?  @db.Uuid
  creator             Creator? @relation("BankAccount_creatorId", fields: [creatorId], references: [id])
  payoutByBankAccount Payout[] @relation("Payout_bankAccountId")

  @@index([creatorId, id])
  @@map("bank_account")
}

/// table: written by E-9 (set up) and E-26 (brand); a business side of an account; brand is embedded JSON (Brand)
model Business {
  id                       String           @id @db.Uuid
  allowance                Int?
  brand                    Json?
  business                 String?
  invoices                 BigInt?
  logins                   Json?
  month                    String?
  name                     String?
  ownerName                String?
  pack                     Int?
  packEnds                 DateTime?        @db.Timestamptz(3)
  person                   String?
  plan                     String?
  record                   Json?
  renews                   DateTime?        @db.Timestamptz(3)
  rolled                   Int?
  since                    DateTime?        @db.Timestamptz(3)
  used                     Int?
  vault                    BigInt?
  vaultUsedGb              Int?
  wishes                   Json?
  version                  Int              @default(0)
  accountId                String?          @db.Uuid
  account                  Account?         @relation("Business_accountId", fields: [accountId], references: [id])
  conciergeOrderByBusiness ConciergeOrder[] @relation("ConciergeOrder_businessId")
  paymentByBusiness        Payment[]        @relation("Payment_businessId")
  storedFileByBusiness     StoredFile[]     @relation("StoredFile_businessId")
  wishByBusiness           Wish[]           @relation("Wish_businessId")
  clientWishByBusiness     ClientWish[]     @relation("ClientWish_businessId")
  invoiceByBusiness        Invoice[]        @relation("Invoice_businessId")
  loginByBusiness          Login[]          @relation("Login_businessId")
  personByBusiness         Person[]         @relation("Person_businessId")
  revealLinkByBusiness     RevealLink[]     @relation("RevealLink_businessId")
  shootByBusiness          Shoot[]          @relation("Shoot_businessId")
  approvedDateByBusiness   ApprovedDate[]   @relation("ApprovedDate_businessId")
  revealAccessByBusiness   RevealAccess[]   @relation("RevealAccess_businessId")
  revealSendByBusiness     RevealSend[]     @relation("RevealSend_businessId")
  vaultPeakByBusiness      VaultPeak[]      @relation("VaultPeak_businessId")

  @@index([accountId, id])
  @@map("business")
}

/// config: the chapter catalogue served by GET /v1/chapter-specs; staff keep it
model ChapterSpec {
  id      String  @id @db.Uuid
  ask     Json?
  heading String?
  line    String?
  rule    String?
  title   String?
  type    Json?
  why     String?

  @@map("chapter_spec")
}

/// table: written by E-30, E-32, E-33 (a business's wish for a client)
model ClientWish {
  id                 String              @id @db.Uuid
  client             String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  day                DateTime?           @db.Date
  endsAt             DateTime?           @db.Timestamptz(3)
  from               String?
  hearts             Json?
  key                String?
  kind               String?
  madeOwn            Boolean?
  no                 String?
  occasion           String?
  openedAt           DateTime?           @db.Timestamptz(3)
  reveal             Json?
  sample             Boolean?
  sentAt             DateTime?           @db.Timestamptz(3)
  set                ClientWishSet?
  shoot              String?
  wish               String?
  wishId             String?             @db.Uuid
  drawFrom           ClientWishDrawFrom?
  drawPaymentId      String?             @db.Uuid
  drawSku            String?
  drawWishes         Int?
  drawnBackAt        DateTime?           @db.Timestamptz(3)
  businessId         String?             @db.Uuid
  wishRef            Wish?               @relation("ClientWish_wishId", fields: [wishId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  business           Business?           @relation("ClientWish_businessId", fields: [businessId], references: [id])
  drawPayment        Payment?            @relation("ClientWish_drawPaymentId", fields: [drawPaymentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revealAccessByWish RevealAccess[]      @relation("RevealAccess_wishId")

  @@unique([wishId])
  @@index([wishId, id])
  @@index([businessId, id])
  @@index([drawPaymentId, id])
  @@map("client_wish")
}

/// table: written by E-34, E-35, E-39, E-40 and server:concierge-orders
model ConciergeOrder {
  id                        String               @id @db.Uuid
  accountId                 String               @db.Uuid
  businessId                String?              @db.Uuid
  kind                      ConciergeOrderKind
  count                     Int
  rush                      Boolean
  brief                     String
  namesFileId               String?              @db.Uuid
  quoteKobo                 BigInt?
  makerId                   String?              @db.Uuid
  status                    ConciergeOrderStatus
  deliverBy                 DateTime?            @db.Timestamptz(3)
  reportFileId              String?              @db.Uuid
  invoiceId                 String?              @db.Uuid
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(3)
  account                   Account              @relation("ConciergeOrder_accountId", fields: [accountId], references: [id])
  business                  Business?            @relation("ConciergeOrder_businessId", fields: [businessId], references: [id])
  invoice                   Invoice?             @relation("ConciergeOrder_invoiceId", fields: [invoiceId], references: [id])
  maker                     StaffAccount?        @relation("ConciergeOrder_makerId", fields: [makerId], references: [id])
  namesFile                 StoredFile?          @relation("ConciergeOrder_namesFileId", fields: [namesFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportFile                StoredFile?          @relation("ConciergeOrder_reportFileId", fields: [reportFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conciergeOrderExtByOrder  ConciergeOrderExt?   @relation("ConciergeOrderExt_orderId")
  conciergeOrderWishByOrder ConciergeOrderWish[] @relation("ConciergeOrderWish_orderId")
  conciergeOrderFileByOrder ConciergeOrderFile[]
  wishByConciergeOrder      Wish[]               @relation("Wish_conciergeOrderId")

  @@index([accountId, id])
  @@index([businessId, id])
  @@index([invoiceId, id])
  @@index([makerId, id])
  @@index([namesFileId, id])
  @@index([reportFileId, id])
  @@index([status, id])
  @@map("concierge_order")
}

/// table: the public creator profile, 1:1 with an account (DEC-76); credits, plan and signed are written by payment fulfilment (E-91, E-93, E-94)
model Creator {
  id                       String            @id @db.Uuid
  counts                   Json?
  credits                  Int?
  earned                   BigInt?
  following                Boolean?
  house                    Boolean?
  href                     String?
  img                      String?
  line                     String?
  name                     String?
  own                      Boolean?
  person                   String?
  plan                     String?
  signed                   Boolean?
  styles                   Json?
  version                  Int               @default(0)
  accountId                String?           @db.Uuid
  account                  Account?          @relation("Creator_accountId", fields: [accountId], references: [id])
  payoutByCreator          Payout[]          @relation("Payout_creatorId")
  royaltyAccrualByCreator  RoyaltyAccrual[]  @relation("RoyaltyAccrual_creatorId")
  styleSubmissionByCreator StyleSubmission[] @relation("StyleSubmission_creatorId")
  bankAccountByCreator     BankAccount[]     @relation("BankAccount_creatorId")
  royaltyReversalByCreator RoyaltyReversal[] @relation("RoyaltyReversal_creatorId")

  @@unique([accountId])
  @@index([accountId, id])
  @@map("creator")
}

/// table: written by E-44 and server:ai-writing (a creator's credits and reviews left)
model CreatorState {
  id           String    @id @db.Uuid
  accountId    String?   @db.Uuid
  credits      Int?
  extraReviews Int?
  on           Boolean?
  packs        Int?
  periodEndsAt DateTime? @db.Timestamptz(3)
  plan         String?
  renews       DateTime? @db.Timestamptz(3)
  reviewsLeft  Int?
  signed       Boolean?
  signedUntil  DateTime? @db.Timestamptz(3)
  signedEnding Boolean   @default(false)
  planEnding   Boolean   @default(false)
  version      Int       @default(0)
  account      Account?  @relation("CreatorState_accountId", fields: [accountId], references: [id])

  @@unique([accountId])
  @@index([accountId, id])
  @@map("creator_state")
}

/// table: written by E-46, E-47 (a person's remembered dates)
model DateRow {
  id              String    @id @db.Uuid
  count           Int?
  date            DateTime? @db.Date
  days            Int?
  for             Json?
  key             String?
  name            String?
  person          Json?
  what            String?
  who             String?
  years           Int?
  accountId       String?   @db.Uuid
  account         Account?  @relation("DateRow_accountId", fields: [accountId], references: [id])
  noticeByDateRow Notice[]  @relation("Notice_dateRowId")

  @@index([accountId, id])
  @@map("date_row")
}

/// table: written by E-49 (staff pick for a day on Now showing)
model DayPick {
  id   String    @id @db.Uuid
  date DateTime? @db.Date
  pick Json?
  wish String?

  @@unique([date])
  @@map("day_pick")
}

/// config: the ending catalogue served by GET /v1/ending-purposes; staff keep it
model EndingPurpose {
  id   String  @id @db.Uuid
  line String?
  name String?

  @@map("ending_purpose")
}

/// config: price-book declaration: what each ticket, plan and pass includes; changed by staff as part of a price-book version
model Entitlements {
  id                           String @id @db.Uuid
  tickets                      Json
  keepsakeExtrasCeilingKobo    BigInt
  passWishes                   Int
  passUpgrades                 Int
  conciergePassDiscountPercent Int
  vatRate                      String
  creator                      Json
  pro                          Json

  @@map("entitlements")
}

/// table: written by E-52 and server:analytics-events (raw app events)
model Event {
  id            String     @id @db.Uuid
  name          EventName
  accountId     String?    @db.Uuid
  wishId        String?    @db.Uuid
  styleSlug     String?
  kind          String?
  amountKobo    BigInt?
  line          EventLine?
  at            DateTime   @db.Timestamptz(3)
  props         Json?
  key           String?
  account       Account?   @relation("Event_accountId", fields: [accountId], references: [id])
  wish          Wish?      @relation("Event_wishId", fields: [wishId], references: [id])
  qrCardByEvent QrCard[]   @relation("QrCard_eventId")

  @@unique([name, accountId, key])
  @@index([accountId, id])
  @@index([wishId, id])
  @@index([styleSlug, name, at])
  @@map("event")
}

/// table: written by E-53..E-56 and server:google-identity (a Google sign-in linked to an account)
model ExternalIdentity {
  id            String                   @id @db.Uuid
  accountId     String                   @db.Uuid
  provider      ExternalIdentityProvider
  subject       String
  email         String?
  emailVerified Boolean
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  returnTo      String?
  account       Account                  @relation("ExternalIdentity_accountId", fields: [accountId], references: [id])

  @@index([accountId, id])
  @@map("external_identity")
}

/// table: written by E-57, E-58 (an account follows a creator)
model Follow {
  id        String   @id @db.Uuid
  handle    String?
  accountId String?  @db.Uuid
  account   Account? @relation("Follow_accountId", fields: [accountId], references: [id])

  @@unique([accountId, handle])
  @@index([accountId, id])
  @@map("follow")
}

/// table: a business invoice issued for a paid plan or pack; listed by E-59, the file built from it by E-60
model Invoice {
  id                      String           @id @db.Uuid
  amount                  BigInt?
  date                    DateTime?        @db.Timestamptz(3)
  key                     String?
  lines                   Json?
  no                      String?
  vat                     BigInt?
  what                    String?
  businessId              String?          @db.Uuid
  business                Business?        @relation("Invoice_businessId", fields: [businessId], references: [id])
  conciergeOrderByInvoice ConciergeOrder[] @relation("ConciergeOrder_invoiceId")
  invoiceLinkByInvoice    InvoiceLink?     @relation("InvoiceLink_invoiceId")

  @@index([businessId, id])
  @@map("invoice")
}

/// table: written by E-62 and server:jobs (timed work definitions and state); one row per job type and subject key (CC4), a second schedule moves the same row
model Job {
  id          String    @id @db.Uuid
  type        JobType
  subjectId   String
  runAt       DateTime  @db.Timestamptz(3)
  status      JobStatus
  attempts    Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  jobRunByJob JobRun[]  @relation("JobRun_jobId")

  @@unique([type, subjectId])
  @@index([status, id])
  @@index([type, id])
  @@map("job")
}

/// table: written by server:jobs (a recorded run of a job)
model JobRun {
  id                     String           @id @db.Uuid
  jobId                  String           @db.Uuid
  startedAt              DateTime         @db.Timestamptz(3)
  finishedAt             DateTime?        @db.Timestamptz(3)
  outcome                JobRunOutcome
  error                  String?
  changed                Json?
  job                    Job              @relation("JobRun_jobId", fields: [jobId], references: [id])
  wishTransitionByJobRun WishTransition[] @relation("WishTransition_jobRunId")

  @@index([jobId, id])
  @@map("job_run")
}

/// table: written by server:ledger and E-65; append-only (no update or delete: database trigger)
model LedgerEntry {
  id         String               @id @db.Uuid
  journalId  String
  account    LedgerEntryAccount
  direction  LedgerEntryDirection
  amountKobo BigInt
  currency   LedgerEntryCurrency
  paymentId  String?              @db.Uuid
  refundId   String?              @db.Uuid
  payoutId   String?              @db.Uuid
  memo       String
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  payment    Payment?             @relation("LedgerEntry_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payout     Payout?              @relation("LedgerEntry_payoutId", fields: [payoutId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund     Refund?              @relation("LedgerEntry_refundId", fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId, id])
  @@index([payoutId, id])
  @@index([refundId, id])
  @@index([account, id])
  @@index([createdAt, id])
  @@map("ledger_entry")
}

/// config: one row of lifecycle terms served inside the public price book (DEC-70); staff change it
model LifecycleConfig {
  id                     String  @id @db.Uuid
  HOLD_DAYS              Int?
  KEEPS                  BigInt?
  OFF                    Int?
  OFF_LINE               Json?
  RESTORE_DAYS           Int?
  TERM_DAYS              Json?
  eraseWithin            String?
  friendMessagesMax      Int?
  keepsakeExtrasCeiling  BigInt?
  maxPhotos              Int?
  noticeBeforeTermEnds   String?
  restingHoldMonths      Int?
  restoreWindow          String?
  restoreWindowDays      Int?
  termRestWindow         String?
  wishContentMaxBytes    Int     @default(262144)
  photoMaxBytes          Int     @default(15728640)
  soundMaxBytes          Int     @default(10485760)
  modelMaxBytes          Int     @default(15728640)
  conciergeDeliveryHours Int     @default(3)
  unopenedDays           Int     @default(365)
  conciergeFilesDays     Int     @default(30)

  @@map("lifecycle_config")
}

/// table: written by E-67, E-68 (a business's member logins)
model Login {
  id         String    @id @db.Uuid
  contact    String?
  status     String?
  businessId String?   @db.Uuid
  business   Business? @relation("Login_businessId", fields: [businessId], references: [id])

  @@index([businessId, id])
  @@map("login")
}

/// table: written by E-70, E-72, E-73 and server:messages-email; II3: idempotencyKey is unique, so one key is one email (the advisory lock is gone)
model MessageDelivery {
  id                String                 @id @db.Uuid
  templateKey       String
  channel           MessageDeliveryChannel
  to                String
  purpose           MessageDeliveryPurpose
  status            MessageDeliveryStatus
  providerMessageId String?
  error             String?
  attempts          Int
  costKobo          BigInt?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  idempotencyKey    String?
  vars              Json?
  noticeByDelivery  Notice[]               @relation("Notice_deliveryId")

  @@unique([idempotencyKey])
  @@index([status, id])
  @@index([providerMessageId])
  @@index([createdAt, id])
  @@map("message_delivery")
}

/// config: message wording kept by staff (messages-email declaration)
model MessageTemplate {
  id          String    @id @db.Uuid
  key         String
  channel     String
  locale      String
  body        String
  version     Int
  approvedRef String?
  subject     String?
  editedAt    DateTime? @db.Timestamptz(3)
  editedBy    String?   @db.Uuid

  @@map("message_template")
}

/// config: the opening and ending scene catalogue served by GET /v1/moments; field definitions stay in the web app (DEC-82)
model Moment {
  id        String   @id @db.Uuid
  dimension String?
  fields    Json?
  from      String?
  kind      String?
  kinds     Json?
  level     String?
  line      String?
  name      String?
  occasions Json?
  quiet     Boolean?
  serves    Json?
  slug      String?
  source    Json?
  tags      Json?

  @@map("moment")
}

/// table: written by E-76 and server:notices
model Notice {
  id         String           @id @db.Uuid
  kind       NoticeKind
  accountId  String?          @db.Uuid
