  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  body                   String?
  text                   String?
  account                Account?              @relation("SupportThread_accountId", fields: [accountId], references: [id])
  assignee               StaffAccount?         @relation("SupportThread_assigneeId", fields: [assigneeId], references: [id])
  supportMessageByThread SupportMessage[]      @relation("SupportMessage_threadId")

  @@index([accountId, id])
  @@index([assigneeId, id])
  @@index([status, id])
  @@map("support_thread")
}

/// config: house Studio templates served by GET /v1/studio/templates; staff keep them
model Template {
  id          String   @id @db.Uuid
  base        String?
  dimension   String?
  handle      String?
  house       Boolean?
  kinds       Json?
  line        String?
  mood        Json?
  name        String?
  orientation String?
  pace        String?
  theme       Json?

  @@map("template")
}

/// table: written by server:storage (a signed upload granted, waiting for its confirm)
model UploadTicket {
  id          String  @id @db.Uuid
  purpose     String?
  bytes       BigInt?
  contentType String?
  subjectId   String?

  @@map("upload_ticket")
}

/// table: a voice note recorded for a wish (dep-graph VoiceNote to Wish), its audio a StoredFile
model VoiceNote {
  id      String  @id @db.Uuid
  audio   Json?
  data    String?
  seconds Int?
  sound   Json?
  voice   String?
  wishId  String? @db.Uuid
  wish    Wish?   @relation("VoiceNote_wishId", fields: [wishId], references: [id])

  @@index([wishId, id])
  @@map("voice_note")
}

/// table: written by E-217 and server:payments; stored once by event id
model WebhookEvent {
  id             String    @id @db.Uuid
  provider       String
  eventId        String
  type           String
  signatureValid Boolean
  payload        Json
  processedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  event          Json?
  outcome        String?

  @@unique([provider, eventId])
  @@index([createdAt, id])
  @@map("webhook_event")
}

/// table: written by E-220, E-222..E-233 and server:wish-lifecycle; content is a document column; content is JSON (DEC-64 typed WishData, DEC-82 Wish.content.details object) though the registry's top-level type reads string
model Wish {
  id                   String           @id @db.Uuid
  accountId            String           @db.Uuid
  businessId           String?          @db.Uuid
  status               WishStatus
  ticket               WishTicket?
  kind                 String
  occasion             String
  styleSlug            String
  opensAt              DateTime?        @db.Timestamptz(3)
  timeZone             String
  weddingDate          DateTime?        @db.Date
  sealedAt             DateTime?        @db.Timestamptz(3)
  openedAt             DateTime?        @db.Timestamptz(3)
  endsAt               DateTime?        @db.Timestamptz(3)
  restingSince         DateTime?        @db.Timestamptz(3)
  keptUntil            DateTime?        @db.Timestamptz(3)
  removedAt            DateTime?        @db.Timestamptz(3)
  eraseAfter           DateTime?        @db.Timestamptz(3)
  erasedAt             DateTime?        @db.Timestamptz(3)
  keptBy               WishKeptBy?
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
  adds                 Json?
  blessing             Json?
  call                 String?
  captions             Json?
  chapter              Json?
  content              Json?
  credits              Json?
  details              Json?
  effect               Json?
  finale               Json?
  keep                 WishKeep?
  letter               String?
  links                Json?
  makerNote            Json?
  memory               Json?
  name                 String?
  no                   String?
  note                 String?
  off                  Boolean?
  photos               Json?
  reasons              Json?
  step                 Int?
  studio               String?
  timeline             Json?
  type                 Json?
  version              Int              @default(0)
  voices               Json?
  passcodeHash         String?
  account              Account          @relation("Wish_accountId", fields: [accountId], references: [id])
  business             Business?        @relation("Wish_businessId", fields: [businessId], references: [id])
  aiRequestByWish      AiRequest[]      @relation("AiRequest_wishId")
  eventByWish          Event[]          @relation("Event_wishId")
  noticeByWish         Notice[]         @relation("Notice_wishId")
  publishRequestByWish PublishRequest[] @relation("PublishRequest_wishId")
  qrCardByWish         QrCard[]         @relation("QrCard_wishId")
  renderJobByWish      RenderJob[]      @relation("RenderJob_wishId")
  reportByWish         Report[]         @relation("Report_wishId")
  voiceNoteByWish      VoiceNote[]      @relation("VoiceNote_wishId")
  wishLinkByWish       WishLink[]       @relation("WishLink_wishId")
  wishTransitionByWish WishTransition[] @relation("WishTransition_wishId")
  publishedWishByWish  PublishedWish[]  @relation("PublishedWish_wishId")
  wishOpenByWish       WishOpen[]       @relation("WishOpen_wishId")
  wishFileByWish       WishFile[]       @relation("WishFile_wishId")
  purchaseGrantByWish  PurchaseGrant[]  @relation("PurchaseGrant_wishId")
  wishReactionByWish   WishReaction[]   @relation("WishReaction_wishId")
  wishFavouriteByWish  WishFavourite[]  @relation("WishFavourite_wishId")
  passDrawByWish       PassDraw[]       @relation("PassDraw_wishId")

  @@unique([no])
  @@index([accountId, id])
  @@index([businessId, id])
  @@index([status, id])
  @@map("wish")
}

/// table: written by server:wish-link (a wish's public slug)
model WishLink {
  id          String    @id @db.Uuid
  slug        String    @db.VarChar(32)
  wishId      String    @db.Uuid
  active      Boolean
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  tries       Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  wish        Wish      @relation("WishLink_wishId", fields: [wishId], references: [id])

  @@unique([slug])
  @@index([wishId, id])
  @@map("wish_link")
}

/// table: written by server:wish-number (issues wish numbers in order)
model WishNumberSequence {
  id        String   @id @db.Uuid
  next      Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("wish_number_sequence")
}

/// table: written by server:wish-link (E-131 records an opening of the public link); LL1: the wish it belongs to, the kind of row (read or play), whether it was the first opening and the opening session (a hash, never an address)
model WishOpen {
  id        String   @id @db.Uuid
  slug      String?
  wishId    String?  @db.Uuid
  kind      String   @default("read")
  first     Boolean  @default(false)
  session   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  wish      Wish?    @relation("WishOpen_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([wishId, id])
  @@map("wish_open")
}

/// table: written by server:wish-lifecycle (every state change of a wish, with the job run that made it)
model WishTransition {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  from      String
  to        String
  cause     String
  jobRunId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  jobRun    JobRun?  @relation("WishTransition_jobRunId", fields: [jobRunId], references: [id])
  wish      Wish     @relation("WishTransition_wishId", fields: [wishId], references: [id])

  @@index([jobRunId, id])
  @@index([wishId, id])
  @@index([createdAt, id])
  @@map("wish_transition")
}

/// table: Y5: a file a wish names (wish, file, role), written when the content is saved; the foreign key keeps a file in a wish from being deleted by any race
model WishFile {
  id        String       @id @db.Uuid
  wishId    String       @db.Uuid
  fileId    String       @db.Uuid
  role      WishFileRole
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  wish      Wish         @relation("WishFile_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file      StoredFile   @relation("WishFile_fileId", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([wishId, fileId, role])
  @@index([wishId, id])
  @@index([fileId, id])
  @@map("wish_file")
}

/// table: EE1: the time limit of one run of each kind of job, in seconds (60 unless a row says otherwise); a config table, no contract shape
model JobKindConfig {
  id               String @id @db.Uuid
  kind             String
  timeLimitSeconds Int

  @@unique([kind])
  @@map("job_kind_config")
}

/// table: GG1: what each paid line granted, one row per payment and line (a handler claims its row first, a refund reads it to take the grant back); written by SQL inside the payment's own transaction
model PurchaseGrant {
  id            String    @id @db.Uuid
  paymentId     String    @db.Uuid
  sku           String
  kind          String
  accountId     String?   @db.Uuid
  businessId    String?   @db.Uuid
  wishId        String?   @db.Uuid
  detail        Json      @default("{}")
  startsAt      DateTime  @db.Timestamptz(3)
  endsAt        DateTime? @db.Timestamptz(3)
  refusedReason String?
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @db.Timestamptz(3)
  payment       Payment   @relation("PurchaseGrant_paymentId", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account       Account?  @relation("PurchaseGrant_accountId", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  business      Business? @relation("PurchaseGrant_businessId", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wish          Wish?     @relation("PurchaseGrant_wishId", fields: [wishId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([paymentId, sku])
  @@index([paymentId, id])
  @@index([accountId, id])
  @@index([businessId, id])
  @@index([wishId, id])
  @@index([businessId, kind])
  @@map("purchase_grant")
}

/// table: LL1: one reaction per opening session of a wish, changeable; written by SQL from the receiver's link, counted for the owner
model WishReaction {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  session   String
  reaction  String
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  wish      Wish     @relation("WishReaction_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([wishId, session])
  @@index([wishId, id])
  @@map("wish_reaction")
}

/// table: LL1: the photo positions an opening session marked, one set per session of a wish; written by SQL from the receiver's link
model WishFavourite {
  id        String   @id @db.Uuid
  wishId    String   @db.Uuid
  session   String
  hearts    Int[]
  updatedAt DateTime @db.Timestamptz(3)
  wish      Wish     @relation("WishFavourite_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([wishId, session])
  @@index([wishId, id])
  @@map("wish_favourite")
}

/// table: LL1, LL4: the public link's limits counted in the database: a bucket, a key (a hash of the address, never the address) and the time; old rows are removed by a timed job
model LinkHit {
  id     String   @id @db.Uuid
  bucket String
  key    String
  at     DateTime @db.Timestamptz(3)

  @@index([bucket, key, at])
  @@map("link_hit")
}

/// table: GG3, GG5: a wish or an upgrade drawn from an account's Pass for one wish; the unique key keeps a wish from drawing twice, and the draw is made in the same transaction as the counter
model PassDraw {
  id           String         @id @db.Uuid
  accountId    String         @db.Uuid
  wishId       String         @db.Uuid
  membershipId String         @db.Uuid
  kind         PassDrawKind
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  account      Account        @relation("PassDraw_accountId", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wish         Wish           @relation("PassDraw_wishId", fields: [wishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  membership   PassMembership @relation("PassDraw_membershipId", fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([wishId, kind])
  @@index([accountId, id])
  @@index([wishId, id])
  @@index([membershipId, id])
  @@map("pass_draw")
}

